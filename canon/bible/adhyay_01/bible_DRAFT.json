 "places": {
  "SHEGAON": {
   "code": "SHEGAON",
   "name": "Shegaon",
   "identity_paragraph": "Shegaon in the 1870s: a small village on the flat open plain of Varhad, dark-brown soil, a cluster of low houses with mud-plastered walls in ochre and earth tones, some roofs of terracotta clay tiles and some thatched, a few neem and babul trees, dusty lanes, no temple spire, no large buildings, no people in view.",
   "images": [
    "FAR_VILLAGE",
    "LOC_SHEGAON_REF",
    "MID_SHEGAON"
   ]
  },
  "ROAD": {
   "code": "ROAD",
   "name": "Road before Devidas's house",
   "identity_paragraph": "The road in front of Devidas's house in Shegaon: a dusty unpaved village road running across the picture; on the left a modest but solid village house with thick mud-plastered ochre walls, a terracotta clay-tile roof, a raised earthen plinth step (ota) and a heavy plain wooden door standing half open onto a dark interior; neighbouring low houses and neem trees further down the road. On the road in front of the door lie several used leaf plates (round plates of stitched dry leaves) with a few scattered grains of leftover white rice.",
   "images": [
    "BEAT_S3_TWO_MEN_SEE",
    "LOC_ROAD_REF",
    "MID_ROAD_HOUSE"
   ]
  },
  "WELL": {
   "code": "WELL",
   "name": "Well and cattle trough",
   "identity_paragraph": "A village well a short way along the same road: a round open well with a low parapet of rough grey-brown stone, and beside it a long rectangular stone water trough (haal) for cattle, its water muddy brown and shallow; dusty trampled ground around it, a neem tree giving a little shade; two or three plain humped Deccan cattle drinking at the far end of the trough.",
   "images": [
    "BEAT_S8_GM_DRINKS",
    "LOC_WELL_REF",
    "MID_WELL_TROUGH"
   ]
  }
 },
