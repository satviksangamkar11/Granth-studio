{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "shot_plan",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "adhyay",
  "scene_id",
  "fingerprints",
  "shots",
  "approved_by",
  "approved_date"
 ],
 "properties": {
  "adhyay": {
   "type": "integer",
   "minimum": 1,
   "maximum": 21
  },
  "scene_id": {
   "type": "string",
   "pattern": "^S[0-9]{1,2}$"
  },
  "fingerprints": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "script",
    "timing",
    "presets",
    "images"
   ],
   "properties": {
    "script": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "timing": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "presets": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "images": {
     "type": "object",
     "additionalProperties": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     }
    }
   }
  },
  "shots": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "shot_id",
     "preset",
     "assets",
     "held_pose",
     "transition_out",
     "need_new"
    ],
    "properties": {
     "shot_id": {
      "type": "string",
      "pattern": "^S[0-9]{1,2}-[0-9]{1,2}$"
     },
     "preset": {
      "type": "string",
      "minLength": 1
     },
     "assets": {
      "type": "object",
      "additionalProperties": {
       "type": "string",
       "pattern": "^SH_S[0-9]{1,2}_[0-9]{2}$"
      }
     },
     "held_pose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
     },
     "transition_out": {
      "enum": [
       "cut",
       "slide",
       "pan_bridge"
      ]
     },
     "need_new": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "reason",
         "class"
        ],
        "properties": {
         "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
         },
         "class": {
          "enum": [
           "missing_image",
           "json_arrangement",
           "renderer_gap"
          ]
         }
        }
       }
      ]
     }
    }
   }
  },
  "approved_by": {
   "type": "string",
   "minLength": 1,
   "maxLength": 400
  },
  "approved_date": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
  }
 }
}