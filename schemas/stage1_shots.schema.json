{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "stage1_shots",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "adhyay",
  "shots"
 ],
 "properties": {
  "adhyay": {
   "type": "integer",
   "minimum": 1,
   "maximum": 21
  },
  "shots": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "shot_id",
     "scene_id",
     "ovi_ids",
     "beat_line_ids",
     "preset_hint",
     "needs_cutout",
     "pose",
     "framing"
    ],
    "properties": {
     "shot_id": {
      "type": "string",
      "pattern": "^S[0-9]{1,2}-[0-9]{1,2}$"
     },
     "scene_id": {
      "type": "string",
      "pattern": "^S[0-9]{1,2}$"
     },
     "ovi_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "integer",
       "minimum": 1
      }
     },
     "beat_line_ids": {
      "type": "array",
      "minItems": 0,
      "items": {
       "type": "string",
       "pattern": "^S[0-9]{1,2}-L[0-9]{1,3}$"
      }
     },
     "preset_hint": {
      "type": "string"
     },
     "needs_cutout": {
      "type": "boolean"
     },
     "pose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
     },
     "framing": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
     }
    }
   }
  }
 }
}