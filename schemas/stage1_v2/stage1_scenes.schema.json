{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adhyay": {
      "maximum": 21,
      "minimum": 1,
      "type": "integer"
    },
    "scenes": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "section_kind": {
                  "const": "discourse"
                }
              }
            },
            "then": {
              "properties": {
                "teaching_treatment": {
                  "not": {
                    "const": "none"
                  }
                }
              },
              "required": [
                "teaching_treatment"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "section_kind": {
                  "const": "story"
                }
              }
            },
            "then": {
              "properties": {
                "teaching_treatment": {
                  "const": "none"
                }
              }
            }
          }
        ],
        "properties": {
          "goal": {
            "maxLength": 400,
            "minLength": 1,
            "type": "string"
          },
          "line_ids": {
            "items": {
              "pattern": "^S[0-9]{1,2}-L[0-9]{1,3}$",
              "type": "string"
            },
            "type": "array"
          },
          "ovi_range": {
            "items": {
              "minimum": 1,
              "type": "integer"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "scene_id": {
            "pattern": "^S[0-9]{1,2}$",
            "type": "string"
          },
          "section_kind": {
            "enum": [
              "story",
              "discourse"
            ],
            "type": "string"
          },
          "teaching_treatment": {
            "enum": [
              "none",
              "narration_over_typography",
              "contemplative_hold",
              "symbol_from_text"
            ],
            "type": "string"
          },
          "turn": {
            "additionalProperties": false,
            "properties": {
              "ovi": {
                "minimum": 1,
                "type": "integer"
              },
              "text": {
                "maxLength": 400,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "ovi",
              "text"
            ],
            "type": "object"
          }
        },
        "required": [
          "scene_id",
          "section_kind",
          "ovi_range",
          "goal",
          "turn",
          "line_ids"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "adhyay",
    "scenes"
  ],
  "title": "stage1_scenes",
  "type": "object"
}
