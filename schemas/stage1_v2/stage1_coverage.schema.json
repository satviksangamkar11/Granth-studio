{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adhyay": {
      "maximum": 21,
      "minimum": 1,
      "type": "integer"
    },
    "ovis": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "PROPOSE_OMISSION"
                }
              },
              "required": [
                "disposition"
              ],
              "type": "object"
            },
            "then": {
              "required": [
                "reason"
              ],
              "type": "object"
            }
          },
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "MERGED_EQUIVALENT"
                }
              },
              "required": [
                "disposition"
              ],
              "type": "object"
            },
            "then": {
              "required": [
                "reason",
                "covered_by"
              ],
              "type": "object"
            }
          }
        ],
        "properties": {
          "covered_by": {
            "oneOf": [
              {
                "pattern": "^S[0-9]{1,2}-L[0-9]{1,3}$",
                "type": "string"
              },
              {
                "minimum": 1,
                "type": "integer"
              }
            ]
          },
          "disposition": {
            "enum": [
              "VISUALISED",
              "NARRATED",
              "QUOTED",
              "MERGED_EQUIVALENT",
              "PROPOSE_OMISSION"
            ],
            "type": "string"
          },
          "ovi": {
            "minimum": 1,
            "type": "integer"
          },
          "reason": {
            "maxLength": 400,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "ovi",
          "disposition"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "adhyay",
    "ovis"
  ],
  "title": "stage1_coverage",
  "type": "object"
}
