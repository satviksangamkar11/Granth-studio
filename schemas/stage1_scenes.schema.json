{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "stage1_scenes",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "adhyay",
  "scenes"
 ],
 "properties": {
  "adhyay": {
   "type": "integer",
   "minimum": 1,
   "maximum": 21
  },
  "scenes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "scene_id",
     "ovi_range",
     "goal",
     "turn",
     "line_ids"
    ],
    "properties": {
     "scene_id": {
      "type": "string",
      "pattern": "^S[0-9]{1,2}$"
     },
     "ovi_range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
       "type": "integer",
       "minimum": 1
      }
     },
     "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
     },
     "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "ovi",
       "text"
      ],
      "properties": {
       "ovi": {
        "type": "integer",
        "minimum": 1
       },
       "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
       }
      }
     },
     "line_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "pattern": "^S[0-9]{1,2}-L[0-9]{1,3}$"
      }
     }
    }
   }
  }
 }
}