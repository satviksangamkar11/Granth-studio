{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "stage1_sound_suggestions",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "adhyay",
  "cues"
 ],
 "properties": {
  "adhyay": {
   "type": "integer",
   "minimum": 1,
   "maximum": 21
  },
  "cues": {
   "type": "array",
   "minItems": 0,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "scene_id",
     "anchor_line_id",
     "palette_id",
     "kind"
    ],
    "properties": {
     "scene_id": {
      "type": "string",
      "pattern": "^S[0-9]{1,2}$"
     },
     "anchor_line_id": {
      "type": "string",
      "pattern": "^S[0-9]{1,2}-L[0-9]{1,3}$"
     },
     "palette_id": {
      "type": "string",
      "pattern": "^(bed|fx)_[a-z0-9_]+$|^NEED_NEW$"
     },
     "kind": {
      "enum": [
       "bed",
       "fx"
      ]
     },
     "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
     }
    }
   }
  }
 }
}