{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "stage1_image_briefs",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "adhyay",
  "images"
 ],
 "properties": {
  "adhyay": {
   "type": "integer",
   "minimum": 1,
   "maximum": 21
  },
  "images": {
   "type": "array",
   "minItems": 0,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "image_id",
     "scene_id",
     "shot_ids",
     "people",
     "place_id",
     "prop",
     "camera",
     "reason_new"
    ],
    "properties": {
     "image_id": {
      "type": "string",
      "pattern": "^s[0-9]{1,2}_[a-z][a-z0-9_]{0,40}$"
     },
     "scene_id": {
      "type": "string",
      "pattern": "^S[0-9]{1,2}$"
     },
     "shot_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "pattern": "^S[0-9]{1,2}-[0-9]{1,2}$"
      }
     },
     "people": {
      "type": "array",
      "minItems": 0,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "name",
        "position",
        "pose",
        "gaze"
       ],
       "properties": {
        "name": {
         "type": "string",
         "minLength": 1,
         "maxLength": 400
        },
        "position": {
         "type": "string",
         "minLength": 1,
         "maxLength": 400
        },
        "pose": {
         "type": "string",
         "minLength": 1,
         "maxLength": 400
        },
        "gaze": {
         "type": "string",
         "minLength": 1,
         "maxLength": 400
        }
       }
      }
     },
     "place_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
     },
     "prop": {
      "type": [
       "string",
       "null"
      ]
     },
     "camera": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
     },
     "reason_new": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
     }
    }
   }
  }
 }
}