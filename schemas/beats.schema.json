{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "beats",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "adhyay",
  "scenes"
 ],
 "properties": {
  "adhyay": {
   "type": "integer",
   "minimum": 1,
   "maximum": 21
  },
  "scenes": {
   "type": "array",
   "minItems": 0,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "scene_id",
     "beats"
    ],
    "properties": {
     "scene_id": {
      "type": "string",
      "pattern": "^S[0-9]{1,2}$"
     },
     "beats": {
      "type": "array",
      "minItems": 0,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "line_id",
        "voice",
        "mr_s",
        "hi_s",
        "start_s",
        "end_s",
        "shot"
       ],
       "properties": {
        "line_id": {
         "type": "string",
         "pattern": "^S[0-9]{1,2}-L[0-9]{1,3}$"
        },
        "voice": {
         "type": "string",
         "minLength": 1,
         "maxLength": 400
        },
        "mr_s": {
         "type": "number",
         "exclusiveMinimum": 0
        },
        "hi_s": {
         "type": "number",
         "exclusiveMinimum": 0
        },
        "start_s": {
         "type": "number",
         "minimum": 0
        },
        "end_s": {
         "type": "number",
         "exclusiveMinimum": 0
        },
        "shot": {
         "type": "integer",
         "minimum": 1
        }
       }
      }
     }
    }
   }
  }
 }
}