{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pilot_review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adhyay",
    "shot",
    "reviewer",
    "decision",
    "ratings",
    "measurement_sha256",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "adhyay": {
      "type": "integer",
      "minimum": 1,
      "maximum": 21
    },
    "shot": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F"
      ]
    },
    "reviewer": {
      "type": "string",
      "pattern": "\\S"
    },
    "decision": {
      "enum": [
        "accept",
        "reject"
      ]
    },
    "ratings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rating"
        ],
        "properties": {
          "rating": {
            "enum": [
              "pass",
              "fail",
              "not_assessed"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "note": {
      "type": "string"
    },
    "measurement_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
