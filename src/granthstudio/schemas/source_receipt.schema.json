{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source_receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adhyay", "version", "research_sha256", "approved_by", "approved_at"],
  "properties": {
    "schema_version": {"const": 1},
    "adhyay": {"type": "integer", "minimum": 1, "maximum": 21},
    "version": {"type": "integer", "minimum": 1},
    "research_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "minLength": 1}
  }
}
