{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "episode_manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "adhyay",
    "research_version",
    "visuals",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "episode_id": {
      "type": "string",
      "pattern": "^ep[0-9]{2}$"
    },
    "adhyay": {
      "type": "integer",
      "minimum": 1,
      "maximum": 21
    },
    "research_version": {
      "type": "integer",
      "minimum": 1
    },
    "visuals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/visual"
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "visual_id": {
      "type": "string",
      "pattern": "^vis_[a-z0-9_]+$"
    },
    "shot_id": {
      "type": "string",
      "pattern": "^a[0-9]{2}_s[0-9]{2}_sh[0-9]{2}$"
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_id",
        "source",
        "path",
        "sha256"
      ],
      "properties": {
        "visual_id": {
          "$ref": "#/$defs/visual_id"
        },
        "source": {
          "enum": [
            "file",
            "keyframe"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "research_scene",
        "location",
        "characters",
        "shots"
      ],
      "properties": {
        "scene_id": {
          "type": "string",
          "pattern": "^a[0-9]{2}_s[0-9]{2}$"
        },
        "research_scene": {
          "type": "string",
          "pattern": "^a[0-9]{2}_s[0-9]{2}$"
        },
        "location": {
          "type": "string",
          "pattern": "^loc_[a-z0-9_]+$"
        },
        "characters": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^chr_[a-z0-9_]+$"
          }
        },
        "props": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lighting": {
          "enum": [
            "day_outdoor",
            "day_indoor",
            "dusk",
            "night",
            "lamplight",
            "unspecified"
          ]
        },
        "artistic_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shot"
          }
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "tier",
        "visual_id",
        "duration_s",
        "dialogue_ids"
      ],
      "properties": {
        "shot_id": {
          "$ref": "#/$defs/shot_id"
        },
        "tier": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "visual_id": {
          "$ref": "#/$defs/visual_id"
        },
        "end_visual_id": {
          "$ref": "#/$defs/visual_id"
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frames": {
          "type": "integer",
          "minimum": 1
        },
        "motion_prompt": {
          "type": "string"
        },
        "dialogue_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^d_[0-9]{4,}$"
          }
        },
        "pilot_shot": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F"
          ]
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "reviewed_by"
          ],
          "properties": {
            "mode": {
              "const": "hold_final_frame"
            },
            "reviewed_by": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        "action_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "kind",
            "reviewed_by"
          ],
          "properties": {
            "mode": {
              "const": "tier0"
            },
            "kind": {
              "enum": [
                "ambient",
                "faithful"
              ]
            },
            "reviewed_by": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        "lip_sync": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "languages",
            "reviewed_by"
          ],
          "properties": {
            "languages": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "mr",
                  "hi"
                ]
              }
            },
            "reviewed_by": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        }
      }
    }
  }
}
