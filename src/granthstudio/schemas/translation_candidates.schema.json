{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "translation_candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adhyay",
    "model",
    "revision",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "adhyay": {
      "type": "integer",
      "minimum": 1,
      "maximum": 21
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dialogue_id",
          "mr_sha256",
          "text",
          "candidate_sha256",
          "generated_at"
        ],
        "properties": {
          "dialogue_id": {
            "type": "string",
            "pattern": "^d_[0-9]{4,}$"
          },
          "mr_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "candidate_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "generated_at": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
