{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "runtime",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resources",
    "storage",
    "workers",
    "sources",
    "python_packages",
    "downloads"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_free_vram_mb",
        "min_ram_mb",
        "min_disk_gb",
        "min_session_remaining_s"
      ],
      "properties": {
        "min_free_vram_mb": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "min_ram_mb": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "min_disk_gb": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "min_session_remaining_s": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "path"
      ],
      "properties": {
        "provider": {
          "enum": [
            null,
            "local_dir"
          ]
        },
        "path": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dual_t4"
      ],
      "properties": {
        "dual_t4": {
          "enum": [
            "disabled",
            "requested"
          ]
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comfyui_repo",
        "comfyui_commit",
        "node_pack_repo",
        "node_pack_commit"
      ],
      "properties": {
        "comfyui_repo": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^https://"
            }
          ]
        },
        "node_pack_repo": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^https://"
            }
          ]
        },
        "comfyui_commit": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          ]
        },
        "node_pack_commit": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          ]
        }
      }
    },
    "python_packages": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "downloads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url",
          "dest",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "dest": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            ]
          }
        }
      }
    }
  }
}
