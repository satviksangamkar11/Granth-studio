{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pilot_config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rubric",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria"
      ],
      "properties": {
        "criteria": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_accepted_sec_per_gpu_hour"
      ],
      "properties": {
        "min_accepted_sec_per_gpu_hour": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        }
      }
    }
  }
}
