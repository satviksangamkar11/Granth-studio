{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "timeline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language",
    "adhyay",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "language": {
      "enum": [
        "mr",
        "hi"
      ]
    },
    "adhyay": {
      "type": "integer",
      "minimum": 1,
      "maximum": 21
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dialogue_id",
        "shot_id",
        "speaker",
        "text"
      ],
      "properties": {
        "dialogue_id": {
          "type": "string",
          "pattern": "^d_[0-9]{4,}$"
        },
        "shot_id": {
          "type": "string",
          "pattern": "^a[0-9]{2}_s[0-9]{2}_sh[0-9]{2}$"
        },
        "speaker": {
          "type": "string",
          "pattern": "^chr_[a-z0-9_]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "alignment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mr_dialogue_id",
            "match",
            "reviewed"
          ],
          "properties": {
            "mr_dialogue_id": {
              "type": "string",
              "pattern": "^d_[0-9]{4,}$"
            },
            "match": {
              "enum": [
                "exact",
                "adapted"
              ]
            },
            "reviewed": {
              "type": "boolean"
            },
            "verification": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reviewer",
                "mr_sha256",
                "hi_sha256"
              ],
              "properties": {
                "reviewer": {
                  "type": "string",
                  "minLength": 1
                },
                "mr_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "hi_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "origin"
              ],
              "properties": {
                "origin": {
                  "enum": [
                    "model_candidate",
                    "human_text"
                  ]
                },
                "model": {
                  "type": "string"
                },
                "revision": {
                  "type": "string"
                },
                "candidate_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "model_identity": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "const": "unverified"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "status",
                        "model",
                        "revision"
                      ],
                      "properties": {
                        "status": {
                          "const": "verified"
                        },
                        "model": {
                          "type": "string",
                          "minLength": 1
                        },
                        "revision": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                },
                "evidence_sha256": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  ]
                }
              }
            }
          }
        },
        "measured_duration_s": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "language",
            "speaker",
            "text_sha256",
            "speech_reviewed_by"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "language": {
              "enum": [
                "mr",
                "hi"
              ]
            },
            "speaker": {
              "type": "string",
              "pattern": "^chr_[a-z0-9_]+$"
            },
            "text_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "speech_reviewed_by": {
              "type": "string",
              "minLength": 1
            },
            "provenance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "origin"
              ],
              "properties": {
                "origin": {
                  "enum": [
                    "imported",
                    "generated"
                  ]
                },
                "voice_id": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "revision": {
                  "type": "string"
                },
                "request_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "asr_report_sha256": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  ]
                },
                "model_identity": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "const": "unverified"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "status",
                        "model",
                        "revision"
                      ],
                      "properties": {
                        "status": {
                          "const": "verified"
                        },
                        "model": {
                          "type": "string",
                          "minLength": 1
                        },
                        "revision": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                },
                "evidence_sha256": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  ]
                }
              }
            }
          }
        },
        "start_s": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
