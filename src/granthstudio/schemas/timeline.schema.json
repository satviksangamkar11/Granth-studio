{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "timeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "adhyay", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "language": {"enum": ["mr", "hi"]},
    "adhyay": {"type": "integer", "minimum": 1, "maximum": 21},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dialogue_id", "shot_id", "speaker", "text"],
      "properties": {
        "dialogue_id": {"type": "string", "pattern": "^d_[0-9]{4,}$"},
        "shot_id": {"type": "string", "pattern": "^a[0-9]{2}_s[0-9]{2}_sh[0-9]{2}$"},
        "speaker": {"type": "string", "pattern": "^chr_[a-z0-9_]+$"},
        "text": {"type": "string", "minLength": 1},
        "alignment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mr_dialogue_id", "match", "reviewed"],
          "properties": {
            "mr_dialogue_id": {"type": "string", "pattern": "^d_[0-9]{4,}$"},
            "match": {"enum": ["exact", "adapted"]},
            "reviewed": {"type": "boolean"}
          }
        },
        "measured_duration_s": {"anyOf": [{"type": "null"}, {"type": "number", "minimum": 0}]}
      }
    }
  }
}
